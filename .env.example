# ============================================================
# CrisisLink — Environment Variable Reference
# Copy this file to .env and fill in the values.
# NEVER commit .env with real secrets to git.
# ============================================================

# ── FRONTEND (Vite — VITE_ prefix required) ──────────────────

# Supabase Project URL (safe to expose — governed by RLS)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon/Public Key (safe to expose — governed by RLS)
# Get from: Supabase Dashboard → Settings → API → Project API Keys → anon/public
VITE_SUPABASE_ANON_KEY=

# Set to "true" to force mock/demo mode even with Supabase configured
VITE_FORCE_MOCK=false

# CARTO API Key for tactical map basemap tiles
VITE_CARTO_API_KEY=

# Optional: Backend FastAPI URL (leave empty to skip FastAPI, use Supabase directly)
VITE_API_BASE_URL=

# ── BACKEND (FastAPI — Python) ────────────────────────────────

# App Identity
APP_NAME=CrisisLink CAD API
ENVIRONMENT=production
API_V1_STR=/api/v1
LOG_LEVEL=INFO

# JWT Secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# JWT token expiry in minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS: comma-separated list of allowed frontend origins
# e.g. https://crisislink-frontend.onrender.com,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase (backend uses service_role key — NEVER expose this in frontend)
# Get from: Supabase Dashboard → Settings → API → Project API Keys → service_role
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=

# Google Gemini API Key
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
